{
	"name": "companion-module-imimot-mitti",
	"version": "4.0.0-beta.1",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-imimot-mitti.git"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"@julusian/bonjour-service": "^1.4.6",
		"node-osc": "^11.7.1"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@types/node": "^26.6.6",
		"eslint": "^10.13.0",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": "^26",
		"yarn": "^4"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.18.1"
}
